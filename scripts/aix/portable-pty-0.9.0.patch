 pub use std::os::unix::io::RawFd;
 
+#[cfg(target_os = "aix")]
+unsafe extern "C" {
+    fn posix_openpt(flags: libc::c_int) -> libc::c_int;
+    fn grantpt(fd: libc::c_int) -> libc::c_int;
+    fn unlockpt(fd: libc::c_int) -> libc::c_int;
+    fn ptsname(fd: libc::c_int) -> *mut libc::c_char;
+}
+
+#[cfg(target_os = "aix")]
+fn openpty_aix(size: &mut winsize) -> anyhow::Result<(RawFd, RawFd)> {
+    let master = unsafe { posix_openpt(libc::O_RDWR | libc::O_NOCTTY) };
+    if master < 0 {
+        bail!("failed to posix_openpt: {:?}", io::Error::last_os_error());
+    }
+    let master = unsafe { FileDescriptor::from_raw_fd(master) };
+    if unsafe { grantpt(master.as_raw_fd()) } != 0 {
+        bail!("failed to grantpt: {:?}", io::Error::last_os_error());
+    }
+    if unsafe { unlockpt(master.as_raw_fd()) } != 0 {
+        bail!("failed to unlockpt: {:?}", io::Error::last_os_error());
+    }
+    let slave_name = unsafe { ptsname(master.as_raw_fd()) };
+    if slave_name.is_null() {
+        bail!("failed to ptsname: {:?}", io::Error::last_os_error());
+    }
+    let slave = unsafe { libc::open(slave_name, libc::O_RDWR | libc::O_NOCTTY) };
+    if slave < 0 {
+        bail!("failed to open PTY slave: {:?}", io::Error::last_os_error());
+    }
+    let slave = unsafe { FileDescriptor::from_raw_fd(slave) };
+    if unsafe { libc::ioctl(slave.as_raw_fd(), libc::TIOCSWINSZ as _, size as *mut _) } != 0 {
+        bail!("failed to set PTY size: {:?}", io::Error::last_os_error());
+    }
+    Ok((master.into_raw_fd(), slave.into_raw_fd()))
+}
